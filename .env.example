# Agent Grand Prix Configuration
AGP_SERVER_URL=https://api.agp.onlatch.com/track/mcp
AGP_TOKEN=your_token_here

# LLM Providers Configuration
# Primary: Groq (Ultra-fast <0.4s response, no timeouts)
REASONING_PROVIDER=openai
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=gsk_your_groq_key_here
LLM_MODEL=groq/compound-mini
OPENAI_FALLBACK_MODEL=groq/compound

# Backup: Google Gemini (Automatic failover if Groq hits rate limits)
GEMINI_API_KEY=AIzaSy_your_gemini_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# Race Profile Settings
RACE_PROFILE=ultra_aggressive  # Options: conservative, balanced, aggressive, ultra_aggressive

# Caching and Persistence Settings
CACHE_DIR=.cache
MEMORY_FILE=memory.json
LEARNING_FILE=learning.json
METRICS_FILE=metrics.json
